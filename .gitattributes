# Line endings matter here, so they are pinned rather than left to autocrlf.
#
#   *.bat                     cmd.exe is happier with CRLF, and the embedded
#                             base64 payloads are decoded to exact byte sequences
#   mma-visibility-guard.js   is base64-embedded into the .bat files, so a
#                             checkout that rewrote its line endings would make
#                             tools/verify-bats-embed.js report a mismatch
#   keyviewer_awa/*.html      is served verbatim and tested by byte-oriented
#                             extraction in the headless tests
#
# Everything else is normalised to LF in the repository.

* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# byte-exact: never touch the line endings
mma-guard/mma-visibility-guard.js -text
keyviewer_awa/index.html -text

*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
